{
  "name": "@deepseek-ai/dsh-tui",
  "description": "The dsh terminal UI bundle: a multi-turn in-process TUI REPL over the agent spine with approval/ask-user answerers, no Host or browser layer",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/tui"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-tui": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./runner": {
      "types": "./lib/types/runner.d.ts",
      "default": "./lib/runner.js"
    },
    "./answerers": {
      "types": "./lib/types/answerers.d.ts",
      "default": "./lib/answerers.js"
    },
    "./capture": {
      "types": "./lib/types/capture.d.ts",
      "default": "./lib/capture.js"
    },
    "./view/store": {
      "types": "./lib/types/view/store.d.ts",
      "default": "./lib/view/store.js"
    },
    "./view/renderer": {
      "types": "./lib/types/view/renderer.d.ts",
      "default": "./lib/view/renderer.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/runner.js",
    "lib/answerers.js",
    "lib/bin.js",
    "lib/capture.js",
    "lib/render/ansi.js",
    "lib/render/markdown.js",
    "lib/render/cards.js",
    "lib/render/projections.js",
    "lib/transport/event-source.js",
    "lib/transport/session-event.js",
    "lib/view/store.js",
    "lib/view/renderer.js",
    "lib/view/app.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "build:view": "bun scripts/build-view.ts",
    "prepare": "bun scripts/build-view.ts",
    "prepublishOnly": "tsx scripts/verify-published-artifacts.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@opentui/core": "^0.5.4",
    "@opentui/keymap": "^0.5.4",
    "@opentui/solid": "^0.5.4",
    "anser": "^2.3.5",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "solid-js": "^1.9.0"
  },
  "optionalDependencies": {
    "@opentui/core-darwin-arm64": "^0.5.4",
    "@opentui/core-darwin-x64": "^0.5.4",
    "@opentui/core-linux-arm64": "^0.5.4",
    "@opentui/core-linux-arm64-musl": "^0.5.4",
    "@opentui/core-linux-x64": "^0.5.4",
    "@opentui/core-linux-x64-musl": "^0.5.4",
    "@opentui/core-win32-arm64": "^0.5.4",
    "@opentui/core-win32-x64": "^0.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-agent-default-model": "workspace:^",
    "@deepseek-ai/dsh-agent-spine-demo": "workspace:^",
    "@deepseek-ai/dsh-bash-local": "workspace:^",
    "@deepseek-ai/dsh-fs-local": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-llm-deepseek": "workspace:^",
    "@deepseek-ai/dsh-llm-replay": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:^",
    "@deepseek-ai/dsh-subprocess-local": "workspace:^",
    "@deepseek-ai/dsh-tool-fs": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-user-approval": "workspace:^",
    "@deepseek-ai/dsh-user-questions": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-agent-default-model": "workspace:^",
    "@deepseek-ai/dsh-agent-spine-demo": "workspace:^",
    "@deepseek-ai/dsh-bash-local": "workspace:^",
    "@deepseek-ai/dsh-fs-local": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-llm-deepseek": "workspace:^",
    "@deepseek-ai/dsh-llm-replay": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:^",
    "@deepseek-ai/dsh-subprocess-local": "workspace:^",
    "@deepseek-ai/dsh-tool-fs": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-user-approval": "workspace:^",
    "@deepseek-ai/dsh-user-questions": "workspace:^",
    "@types/mdast": "^4.0.4",
    "execa": "^10.0.0"
  }
}
